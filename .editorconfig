# Top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning

# Markdown files
[*.md]
trim_trailing_whitespace = false

# YAML/JSON files
[*.{yml,yaml,json}]
indent_size = 2
